# Prometheus 데이터 저장소 (Git 관리 X)
metric-platform/prometheus/volume/data/
metric-platform/prometheus/volume/wal/
metric-platform/prometheus/volume/chunks_head/
metric-platform/prometheus/volume/*-meta.json
metric-platform/prometheus/volume/*-index
metric-platform/prometheus/volume/*-tombstones
metric-platform/prometheus/config/query_log_file.log

# Grafana 기본 데이터 디렉토리 (Git 관리 X)
metric-platform/grafana/volume/grafana.db
metric-platform/grafana/volume/log/
metric-platform/grafana/volume/plugins/

# Grafana 세션 정보 (사용자 설정 변경 시 충돌 방지)
metric-platform/grafana/volume/data/sessions/

# Grafana 캐시 및 런타임 파일 제외
metric-platform/grafana/volume/data/png/
metric-platform/grafana/volume/data/tts_cache/
metric-platform/grafana/volume/data/log/

# Grafana 프로비저닝된 대시보드는 제외하지 않음 (Git으로 관리)
!metric-platform/grafana/provisioning/dashboards.yaml
!metric-platform/grafana/provisioning/datasources.yaml

# Grafana 대시보드 JSON 파일은 Git으로 관리
!metric-platform/grafana/dashboards/*.json
