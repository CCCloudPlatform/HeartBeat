# Prometheus 데이터 저장소 (Git 관리 X)
prometheus/volume/data/
prometheus/volume/wal/
prometheus/volume/chunks_head/
prometheus/volume/*-meta.json
prometheus/volume/*-index
prometheus/volume/*-tombstones
prometheus/config/query_log_file.log

# Grafana 기본 데이터 디렉토리 (Git 관리 X)
grafana/volume/grafana.db
grafana/volume/log/
grafana/volume/plugins/

# Grafana 세션 정보 (사용자 설정 변경 시 충돌 방지)
grafana/volume/data/sessions/

# Grafana 캐시 및 런타임 파일 제외
grafana/volume/data/png/
grafana/volume/data/tts_cache/
grafana/volume/data/log/

# Grafana 프로비저닝된 대시보드는 제외하지 않음 (Git으로 관리)
!grafana/provisioning/dashboards.yaml
!grafana/provisioning/datasources.yaml

# Grafana 대시보드 JSON 파일은 Git으로 관리
!grafana/dashboards/*.json

.DS_Store

# minio 데이터 저장소 하위 파일들 초기 세팅시 제외 (Git 관리 X) 
minio_data/